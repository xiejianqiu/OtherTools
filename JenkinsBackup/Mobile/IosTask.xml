              <string>None</string>
              <string>UpdateNoRevert</string>
              <string>UpdateAndRevert</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.ChoiceParameterDefinition>
          <name>BuildMode</name>
